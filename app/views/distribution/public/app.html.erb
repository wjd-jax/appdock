<% content_for :title, "#{@app.name} · 团队下载" %>
<link rel="stylesheet" href="/distribution/download.css?v=15"><div class="download-scene app-download"><div class="download-center"><div class="download-identity"><% if @latest.first %><div class="app-icon"><%= app_icon(@latest.first) %></div><% end %><img class="qr" src="<%= distribution_app_qrcode_path(@app, size: 'large') %>" alt="应用下载二维码"></div><div><h1><%= @app.name %></h1></div>
<% if @latest.empty? %><div class="card empty"><h2>暂时没有可用安装包</h2><p>请开发同事上传此应用的 IPA 或 APK。</p></div><% end %>
<div class="platform-list"><% @latest.each do |r| %><section class="card platform-card" data-platform-card="<%= r.platform %>"><div class="row spread"><h2 class="platform-label"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 5h4m-3 14h2"/></svg><%= distribution_platform(r) %></h2><span class="badge">最新版本</span></div><p class="version-number"><%= r.release_version.presence || r.version %><small>Build <%= r.build_version.presence || '—' %></small></p><p class="muted"><%= number_to_human_size(r.size || 0) %> · <%= distribution_time(r.created_at) %></p><% if r.ios? && r.cert_expired? %><p class="notice alert">签名已过期，请联系开发者重新打包。</p><% else %><a class="button full primary-install" href="<%= r.install_url %>"><%= r.ios? ? '安装到 iPhone / iPad' : '下载安装包' %> ↓</a><% end %><% notes = r.text_changelog(default_template: false) %><% if notes.present? %><% note_lines = notes.lines.map(&:strip).reject(&:blank?) %><section class="latest-notes" aria-label="最新版本更新日志"><div class="notes-heading"><h3>版本更新</h3><span><%= note_lines.size %> 条</span></div><ul class="notes-preview"><% note_lines.first(3).each do |line| %><li><%= line.sub(/\A-\s*/, '') %></li><% end %></ul><% if note_lines.size > 3 %><details class="more-notes"><summary><span class="expand-label">展开全部更新</span><span class="collapse-label">收起更新</span></summary><div class="changelog"><%= distribution_notes(r) %></div></details><% end %></section><% end %><a class="text-link version-detail-link" href="<%= r.release_url %>">版本详情 →</a></section><% end %></div>
<p class="notice" data-platform-unavailable hidden></p>
<div class="download-utilities"><details class="history-panel" data-platform-history><summary>历史版本</summary><% @history.each do |r| %><a class="history-row" data-history-platform="<%= r.platform %>" href="<%= r.release_url %>"><span><%= distribution_platform(r) %> · <%= r.release_version.presence || r.version %><small> Build <%= r.build_version %></small></span><span class="muted"><%= distribution_time(r.created_at) %></span></a><% end %></details><div class="utility-links"><% if !Distribution::PublicContext.external && Distribution::NetworkAccess.live? %><a class="utility-link" href="https://<%= ENV.fetch('APPDOCK_PUBLIC_HOST', 'download.17love.life') %>/a/<%= @app.id %>" target="_blank" rel="noopener">打开外网下载页 ↗</a><% end %><button class="utility-link" type="button" data-copy="<%= Distribution::AppDownloads.new(@app).url %>">复制应用链接</button></div></div></div></div>
