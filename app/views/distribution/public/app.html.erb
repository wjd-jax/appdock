<% content_for :title, "#{@app.name} · 团队下载" %>
<link rel="stylesheet" href="/distribution/download.css?v=4"><div class="download-scene app-download"><div class="download-center"><div class="download-identity"><% if @latest.first %><div class="app-icon"><%= app_icon(@latest.first) %></div><% end %><img class="qr" src="<%= distribution_app_qrcode_path(@app, size: 'large') %>" alt="应用下载二维码"></div><div><span class="eyebrow">团队内部应用</span><h1><%= @app.name %></h1><p class="muted">各平台最新可用版本，上传新包后自动更新。</p></div>
<% if @latest.empty? %><div class="card empty"><h2>暂时没有可用安装包</h2><p>请开发同事上传此应用的 IPA 或 APK。</p></div><% end %>
<div class="platform-list"><% @latest.each do |r| %><section class="card platform-card" data-platform-card="<%= r.platform %>"><div class="row spread"><h2 class="platform-label"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 5h4m-3 14h2"/></svg><%= distribution_platform(r) %></h2><span class="badge">最新版本</span></div><p class="version-number"><%= r.release_version.presence || r.version %><small>Build <%= r.build_version.presence || '—' %></small></p><p class="muted"><%= number_to_human_size(r.size || 0) %> · <%= distribution_time(r.created_at) %></p><% if r.ios? && r.cert_expired? %><p class="notice alert">签名已过期，请联系开发者重新打包。</p><% else %><a class="button full primary-install" href="<%= r.install_url %>"><%= r.ios? ? '安装到 iPhone / iPad' : '下载安装包' %> ↓</a><% end %><a class="text-link" href="<%= r.release_url %>">更新日志与版本详情 →</a></section><% end %></div>
<details class="card"><summary>历史版本</summary><% @history.each do |r| %><a class="history-row" href="<%= r.release_url %>"><span><%= distribution_platform(r) %> · <%= r.release_version.presence || r.version %><small> Build <%= r.build_version %></small></span><span class="muted"><%= distribution_time(r.created_at) %></span></a><% end %></details><button class="text-button" data-copy="<%= Distribution::AppDownloads.new(@app).url %>">复制应用链接</button></div></div>
