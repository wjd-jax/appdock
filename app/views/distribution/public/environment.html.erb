<% content_for :title, "#{@scheme.app.name} · #{@scheme.name}" %>
<div class="download-grid"><section><div class="hero"><span class="eyebrow">固定测试入口</span><h1><%= @scheme.app.name %></h1><p class="lead"><%= @scheme.name %></p><p class="muted">这里展示开发者明确推荐的版本，上传新包不会自动替换。</p></div>
<% if @available.empty? %><section class="card empty"><h2>还没有推荐版本</h2><p>开发者完成测试并设置推荐后，安装包会出现在这里。</p></section><% end %>
<div class="platform-list"><% @available.each do |r| %><section class="card platform-card" data-platform-card="<%= r.platform %>"><div class="row spread"><h2><%= distribution_platform(r) %> <small><%= r.channel.name %></small></h2><span class="badge green">推荐</span></div><p class="version-number"><%= r.release_version.presence || r.version %><small>Build <%= r.build_version.presence || '—' %></small></p><p class="muted"><%= number_to_human_size(r.size || 0) %> · <%= distribution_time(r.created_at) %></p><a class="button" href="<%= r.release_url %>">查看更新并安装 →</a></section><% end %></div>
<details class="card"><summary>可用历史版本</summary><% @channels.each do |channel| %><h3><%= channel.name %></h3><% channel.releases.order(id: :desc).limit(20).each do |r| %><% next unless r.file? && r.valid_share_token?(r.share_token) %><a class="history-row" href="<%= r.release_url %>"><span><%= r.release_version.presence || r.version %> <small><%= r.build_version %></small></span><span class="muted"><%= distribution_time(r.created_at) %></span><span class="badge status-<%= r.distribution_status %>"><%= r.distribution_label %></span></a><% end %><% end %></details></section>
<aside class="card share-card"><span class="eyebrow">ONE LINK · ALL PLATFORMS</span><h2>固定环境二维码</h2><img class="qr" src="<%= distribution_environment_qrcode_path(@scheme,**(DistributionAccess.trusted_lan? ? {} : {share: @scheme.distribution_share_token}),size:'large') %>" alt="固定测试环境二维码"><p class="muted">推荐版本变化后，二维码无需重发。</p><input id="environment-url" readonly aria-label="固定环境链接" value="<%= @scheme.distribution_url %>"><button class="button secondary full" data-copy-target="environment-url">复制固定链接</button></aside></div>
