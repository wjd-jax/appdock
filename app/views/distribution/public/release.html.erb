<% content_for :title, "#{@release.app.name} · #{@release.release_version || @release.version}" %>
<link rel="stylesheet" href="/distribution/download.css?v=17">
<div class="download-scene"><div class="download-center"><div class="download-identity"><div class="app-icon"><%= app_icon(@release) %></div><img class="qr" src="<%= @release.qrcode_url(:large) %>" alt="此版本下载二维码"></div><span class="eyebrow"><%= distribution_platform(@release) %> · <span class="environment-tag" data-business-environment="<%= @release.business_environment_key %>"><%= @release.business_environment_label %></span></span><h1><%= @release.app.name %></h1><p class="muted desktop-download-hint">扫描二维码下载，或在手机浏览器中打开此页</p><p class="muted mobile-download-hint">点击下方按钮下载安装</p><button class="text-button" data-copy="<%= @release.release_url %>">复制下载链接 ↗</button><div class="download-meta">版本 <%= @release.release_version.presence || @release.version %> · Build <%= @release.build_version.presence || '—' %> · <%= number_to_human_size(@release.size || 0) %><br>更新于 <%= distribution_time(@release.created_at) %></div>
<% unless logged_in_or_without_auth?(@release) %>
<section class="card"><h2>输入下载密码</h2><p class="muted">开发者为这个安装包设置了下载密码。</p><%= form_tag auth_channel_release_path(@release.channel,@release), method: :post do %><%= hidden_field_tag :share, params[:share] %><label>下载密码<%= password_field_tag :password,nil,required:true,autocomplete:'off' %></label><% if @error_message %><p role="alert" class="error"><%= @error_message %></p><% end %><button class="button">验证并继续</button><% end %></section>
<% else %>
<section class="card install-card"><div class="row spread"><span class="badge"><%= distribution_platform(@release) %> 安装包</span></div>
<p class="muted"><%= number_to_human_size(@release.size || 0) %> · 更新于 <%= distribution_time(@release.created_at) %></p>
<% if @release.file? && @release.distribution_status != 'retired' && !@release.app.archived? %>
<% if @release.ios? && @release.cert_expired? %><p class="notice alert">此 IPA 的签名描述文件已过期，请联系开发者重新打包。</p><% else %><a class="button primary-install" data-platform="<%= @release.platform %>" href="<%= @release.install_url %>"><%= @release.ios? ? '安装到 iPhone / iPad' : '下载安装包' %> <span>↓</span></a><% end %>
<% if @release.ios? %><p class="hint">请在 Safari 中打开。安装还需满足此 IPA 的签名与设备授权条件。</p><a class="text-link" href="<%= @release.download_url %>">仅下载 IPA 文件</a><% else %><p class="hint">Android 如提示安装来源，请按系统提示允许本次安装。</p><% end %>
<p class="device-hint" data-device-hint="<%= @release.platform %>"></p>
<% else %><p class="notice alert">这个版本已停用、归档或文件不可用，请联系开发者。</p><% end %></section>
<% if @release.text_changelog(default_template: false).present? %><section class="download-notes"><h2>更新日志</h2><div class="changelog"><%= distribution_notes(@release) %></div></section><% end %>
<% if DistributionAccess.trusted_lan? || user_signed_in? %><a class="text-link" href="<%= Distribution::AppDownloads.new(@release.app).package_path(@release) %>">查看此安装包的其他版本 →</a> <a class="text-link" href="<%= Distribution::AppDownloads.new(@release.app).path %>">查看产品汇总页 →</a><% end %>
<details class="card"><summary>版本详情</summary><dl><dt>包标识</dt><dd><%= @release.bundle_id %></dd><dt>SHA-256</dt><dd class="mono"><%= @release.file_sha256.presence || '尚未生成' %></dd></dl></details>
<% end %></div></div>
