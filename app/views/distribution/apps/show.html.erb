<% content_for :title, @package_view ? "#{@app.name} · #{@package_platform} · #{@package_bundle_id} · 包管理" : "#{@app.name} · 应用管理" %>
<link rel="stylesheet" href="/distribution/manage.css?v=8">
<a class="muted" href="<%= distribution_workspace_path %>">团队应用</a> / <a class="muted" href="<%= distribution_manage_app_path(@app) %>"><%= @app.name %></a><% if @package_view %> / <%= @package_platform %> · <%= @package_bundle_id %><% end %>
<section class="manage-header"><div class="app-icon"><% if (@package_view ? @package_release : @header_releases.first) %><%= app_icon(@package_view ? @package_release : @header_releases.first) %><% end %></div><div class="manage-heading"><h1><%= @app.name %><% if @package_view %> · <%= @package_platform %><% end %></h1><% if @package_view %><p class="muted"><%= @package_bundle_id %></p><button class="text-button" data-copy="<%= Distribution::AppDownloads.new(@app).package_url(@package_release) %>"><%= Distribution::AppDownloads.new(@app).package_url(@package_release) %></button><div class="row"><% [['testing', '复制测试版链接'], ['production', '复制正式版链接']].each do |environment, label| %><button class="text-button" data-copy="<%= Distribution::AppDownloads.new(@app).package_url(@package_release, environment: environment) %>"><%= label %></button><% end %></div><% else %><button class="text-button" data-copy="<%= Distribution::AppDownloads.new(@app).url %>"><%= Distribution::AppDownloads.new(@app).url %></button><p class="muted"><%= @header_releases.map { |r| distribution_platform(r) }.uniq.join(' / ') %></p><% end %></div><div class="manage-controls"><a class="button" href="#upload-form" data-select-package>上传新版本 ↑</a><a class="button secondary" href="<%= @package_view ? Distribution::AppDownloads.new(@app).package_path(@package_release) : Distribution::AppDownloads.new(@app).path %>" target="_blank" rel="noopener">预览下载页 ↗</a><%= form_tag (@package_view ? distribution_manage_package_path(@app, @package_platform, @package_bundle_id) : distribution_manage_app_path(@app)), method: :delete, class: 'manage-delete-form', data: {delete_confirm: (@package_view ? "确定删除 #{@app.name} 的 #{@package_platform} 安装包 #{@package_bundle_id}？测试和正式环境的全部历史版本、文件和更新日志将永久删除，下载链接将失效，无法撤销。" : "确定删除产品 #{@app.name}？所有平台、测试和正式环境的安装包及全部历史版本将永久删除，所有下载链接将失效，无法撤销。")} do %><button class="text-button manage-delete" type="submit"><%= @package_view ? '删除安装包' : '删除产品' %></button><% end %></div></section>
<nav class="manage-tabs"><% if @package_view %><a href="#versions">此包版本</a><a href="<%= distribution_manage_app_path(@app) %>">产品设置</a><% else %><a href="#basic">基本信息</a><a href="#versions">版本管理</a><% end %><a href="<%= distribution_developer_path %>">自动上传接入 ↗</a></nav>
<% unless @package_view %><section class="card" id="basic"><h2>基本信息</h2><%= form_with model: @app, url: distribution_manage_app_path(@app), method: :patch do |f| %><label>应用名称<%= f.text_field :name, required: true, maxlength: 100 %></label><button class="button secondary">保存名称</button><% end %><p class="muted">同名产品共用汇总链接；每个平台和包标识有独立固定链接。修改名称后，现有链接保持不变。</p></section><% end %>
<div class="manage-upload"><%= render 'distribution/uploads/picker' %></div>
<section id="versions" class="version-timeline"><h2><%= @package_view ? '此包版本' : '版本管理' %></h2><nav class="environment-tabs" aria-label="筛选历史版本环境"><% [['all', '全部'], ['testing', '测试环境'], ['production', '正式环境']].each do |value, label| %><a href="?business_environment=<%= value %>#versions" aria-current="<%= @environment_filter == value ? 'page' : 'false' %>"><%= label %></a><% end %></nav><% @releases.each do |r| %><article class="version-event" data-environment-item="<%= r.business_environment_key %>"><div class="version-event-header"><h3><%= r.release_version.presence || r.version %> <small>Build <%= r.build_version.presence || '—' %></small><span class="badge"><%= distribution_platform(r) %></span> <span class="environment-tag" data-business-environment="<%= r.business_environment_key %>"><%= r.business_environment_label %></span></h3><button class="text-button version-copy-link" data-copy="<%= Distribution::AppDownloads.new(@app).package_url(r) %>">复制固定链接</button></div><p class="muted"><%= distribution_time(r.distribution_uploaded_at) %> · <%= number_to_human_size(r.size || 0) %> · <%= r.distribution_status == 'retired' ? '已停用' : '可用' %> · <span title="文件下载请求次数；不代表安装成功">下载 <%= number_with_delimiter(r.download_count) %> 次</span></p><% if r.text_changelog(default_template: false).present? %><div class="changelog"><%= distribution_notes(r) %></div><% end %><div class="row"><% if r.file? && r.distribution_status != 'retired' %><a class="button secondary" href="<%= r.release_url %>" target="_blank" rel="noopener">预览下载页</a><a class="text-link" href="<%= r.download_url %>">下载原文件</a><% end %><button type="button" class="text-button version-edit-notes" data-edit-notes data-update-url="<%= distribution_version_path(r) %>" data-return-to="<%= @package_view ? 'package' : '' %>" data-version-label="<%= r.release_version.presence || r.version %> · Build <%= r.build_version.presence || '—' %> · <%= r.platform %>" data-notes="<%= r.text_changelog(default_template: false) %>">编辑更新日志</button><%= form_tag distribution_version_path(r), method: :delete, class: 'version-delete-form', data: {delete_confirm: "确定删除 #{@app.name} 的 #{r.platform} 版本 #{r.release_version.presence || r.version}（#{r.business_environment_label}，Build #{r.build_version.presence || '—'}）？此版本文件和更新日志将永久删除，版本链接将失效，无法撤销。"} do %><%= hidden_field_tag :return_to, 'package' if @package_view %><button class="text-button manage-delete" type="submit">删除此版本</button><% end %></div></article><% end %><% if @releases.empty? && @environment_filter != 'all' %><p class="muted environment-filter-empty">该环境暂无历史版本</p><% end %><% if @releases.empty? && @environment_filter == 'all' %><p class="muted">还没有版本，上传安装包后显示在这里。</p><% end %></section>
