<% content_for :title, "#{@app.name} · 应用管理" %>
<link rel="stylesheet" href="/distribution/manage.css?v=3">
<a class="muted" href="<%= distribution_workspace_path %>">团队应用 / <%= @app.name %></a>
<section class="manage-header"><div class="app-icon"><% if @releases.first %><%= app_icon(@releases.first) %><% end %></div><div class="manage-heading"><h1><%= @app.name %></h1><button class="text-button" data-copy="<%= Distribution::AppDownloads.new(@app).url %>"><%= Distribution::AppDownloads.new(@app).url %></button><p class="muted"><%= @releases.map { |r| distribution_platform(r) }.uniq.join(' / ') %></p></div><div class="manage-controls"><a class="button" href="#upload-form" data-select-package>上传新版本 ↑</a><a class="button secondary" href="<%= distribution_app_path(@app) %>" target="_blank" rel="noopener">预览下载页 ↗</a></div></section>
<nav class="manage-tabs"><a href="#basic">基本信息</a><a href="#versions">版本管理</a><a href="<%= distribution_developer_path %>">自动上传接入 ↗</a></nav>
<section class="card" id="basic"><h2>基本信息</h2><%= form_with model: @app, url: distribution_manage_app_path(@app), method: :patch do |f| %><label>应用名称<%= f.text_field :name, required: true, maxlength: 100 %></label><button class="button secondary">保存名称</button><% end %><p class="muted">安装包标识与平台自动识别，新版本上传后自动更新下载入口。</p></section>
<div class="manage-upload"><%= render 'distribution/uploads/picker' %></div>
<section id="versions" class="version-timeline"><h2>版本管理</h2><% @releases.each do |r| %><article class="version-event"><h3><%= r.release_version.presence || r.version %> <small>Build <%= r.build_version.presence || '—' %></small><span class="badge"><%= distribution_platform(r) %></span></h3><p class="muted"><%= distribution_time(r.created_at) %> · <%= number_to_human_size(r.size || 0) %> · <%= r.distribution_status == 'retired' ? '已停用' : '可用' %></p><% if r.text_changelog(default_template: false).present? %><div class="changelog"><%= distribution_notes(r) %></div><% end %><div class="row"><% if r.file? && r.distribution_status != 'retired' %><a class="button secondary" href="<%= r.release_url %>" target="_blank" rel="noopener">预览下载页</a><a class="text-link" href="<%= r.download_url %>">下载原文件</a><% end %></div><details><summary>编辑更新日志（选填）</summary><%= form_tag distribution_version_path(r), method: :patch do %><label class="sr-only" for="notes-<%= r.id %>">更新日志</label><textarea id="notes-<%= r.id %>" name="changelog" rows="4"><%= r.text_changelog(default_template: false) %></textarea><button class="button secondary">保存更新日志</button><% end %></details></article><% end %><% if @releases.empty? %><p class="muted">还没有版本，上传安装包后显示在这里。</p><% end %></section>
