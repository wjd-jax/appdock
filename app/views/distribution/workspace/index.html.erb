<% content_for :title, '我的应用' %>
<div class="workspace-tools"><h1>我的应用</h1><input class="app-search" id="app-search" type="search" placeholder="输入名称搜索" aria-label="搜索应用"></div>
<div class="workspace-note">团队内部应用分发 <span style="float:right">支持 iOS / Android</span></div>
<div class="app-gallery"><%= render 'distribution/uploads/picker' %><% @apps.each do |app| %><% versions = @downloads.fetch(app.id); r=versions.first %><article class="fir-app" data-app-name="<%= app.name.downcase %>"><span class="app-platform"><%= versions.map { |v| distribution_platform(v) }.join(' / ') %></span><a class="app-icon" href="<%= distribution_manage_app_path(app) %>"><% if r %><%= app_icon(r) %><% end %></a><h2><%= app.name %></h2><dl><dt>下载链接</dt><dd><button class="text-button" style="padding:0;font-size:12px" data-copy="<%= Distribution::AppDownloads.new(app).url %>">复制固定链接</button></dd><dt>Bundle ID</dt><dd><%= r&.bundle_id || '—' %></dd><dt>最新版本</dt><dd><%= r&.release_version.presence || r&.version || '暂无' %><% if r&.build_version.present? %> (Build <%= r.build_version %>)<% end %></dd><dt>更新时间</dt><dd><%= distribution_time(r&.created_at) %></dd></dl><div class="row"><a href="<%= distribution_manage_app_path(app) %>">编辑</a><a href="<%= distribution_app_path(app) %>" target="_blank" rel="noopener">预览</a></div></article><% end %></div>
<div class="workspace-bottom"><a href="<%= distribution_developer_path %>">开发者与 AI 自动上传</a><a href="<%= distribution_operations_path %>">运行状态</a></div>
