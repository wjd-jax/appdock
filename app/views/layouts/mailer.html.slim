doctype html
html
  head
    title = yield :title
    link[rel="apple-touch-icon" sizes="180x180" href="#{asset_path('/distribution/appdock-octopus-touch-20261117.png')}"]
    link[rel="icon" type="image/svg+xml" href="#{asset_path('/distribution/appdock-octopus-20261117.svg')}"]
    meta[name="turbo-prefetch" content="false"]
    == favicon_link_tag '/distribution/appdock-octopus-20261117.svg'
    == stylesheet_link_tag 'application'
    == javascript_include_tag 'application', defer: true
    == csrf_meta_tags

  body.hold-transition.layout-top-nav[
    data-controller="global"
    data-global-root-url-value="#{root_url}"
    data-global-appearance-value="#{Setting.site_appearance}"
  ]
    .container
      .col.align-self-center.mt-5
        .card.card-outline.card-primary
          .card-header.text-center
            = link_to Setting.site_title, Setting.site_domain, class: 'h1'
          .card-body
            = yield
